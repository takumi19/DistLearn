# secrets.env — fill in and save as secrets.env (gitignored).
# Source before using render_cloud_init.py or orchestrate.py:
#   source cloud/secrets.env

# ── SSH key that the orchestrator uses to reach nodes ────────────────────────
ORCHESTRATOR_SSH_PUBKEY_PATH=~/.ssh/decentr_id_ed25519.pub

# ── Project repository (the ML code cloned on each node) ─────────────────────
# Public HTTPS repo — set PROJECT_DEPLOY_KEY_PATH="" for public repos.
PROJECT_REPO_URL=https://github.com/YOURNAME/Decentr_my_own.git
PROJECT_REPO_BRANCH=main
PROJECT_DEPLOY_KEY_PATH=    # leave blank for public HTTPS repos

# ── Results repository (CSV / JSON / MD pushed here by nodes) ────────────────
RESULTS_REPO_URL=git@github.com:YOURNAME/decentr-results.git
RESULTS_DEPLOY_KEY_PATH=~/.ssh/decentr_results_deploy_key
RESULTS_GIT_NAME="Decentr Bot"
RESULTS_GIT_EMAIL="decentr-bot@example.com"

# ── Tailscale (only for cloud-init.yaml.template — NOT used in subnet/Terraform mode) ──
# In Terraform/subnet mode this value is ignored; any non-empty string is fine.
TAILSCALE_AUTH_KEY=tskey-auth-DUMMY-VALUE

# ── Selectel OpenStack (used by provision/selectel.py list-flavors) ──────────
SEL_DOMAIN_NAME=123456          # account ID shown top-right in Selectel panel
SEL_USERNAME=decentr-svc        # service-user name
SEL_PASSWORD=CHANGE_ME          # service-user password
SEL_PROJECT_ID=abcdef01234...   # project UUID
SEL_REGION=ru-9
