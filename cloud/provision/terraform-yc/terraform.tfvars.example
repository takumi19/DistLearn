# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# Auth: do NOT put credentials here.
# Instead set the environment variable before running terraform:
#   export YC_TOKEN=$(yc iam create-token)
# Token is valid 12 hours. For longer runs use a service account key file:
#   export YC_SERVICE_ACCOUNT_KEY_FILE=/path/to/key.json

# ─── Required ─────────────────────────────────────────────────────────────────

folder_id = "CHANGE_ME"    # e.g. "b1g8ulhq8n1q6x0b"  (`yc resource-manager folder list`)

# ─── Zone / region ────────────────────────────────────────────────────────────

zone = "ru-central1-a"     # or ru-central1-b, ru-central1-c, ru-central1-d

# ─── Sizing ───────────────────────────────────────────────────────────────────

server_count   = 20
platform_id    = "standard-v3"   # Intel Ice Lake
node_cpu_cores = 4
node_memory_gb = 8
core_fraction  = 100              # 100 = dedicated CPU (required for training)
preemptible    = false            # true saves ~30% but YC may stop after 24h

image_family   = "ubuntu-2404-lts"
volume_size_gb = 40
disk_type      = "network-ssd"

# ─── Networking ───────────────────────────────────────────────────────────────

cluster_name     = "decentr"
subnet_cidr      = "192.168.199.0/24"
ssh_allowed_cidr = "0.0.0.0/0"   # tighten to your IP/32 for security

# ─── SSH ──────────────────────────────────────────────────────────────────────

ssh_public_key_path  = "~/.ssh/decentr_id_ed25519.pub"
ssh_private_key_path = "~/.ssh/decentr_id_ed25519"

# ─── cloud-init ───────────────────────────────────────────────────────────────
# Render first (from this directory):
#   python3 ../../../render_cloud_init.py \
#     --template cloud-init.yc.yaml.template \
#     --out cloud-init.rendered.yaml
cloud_init_path = "cloud-init.rendered.yaml"
