# GENERATED BY TERRAFORM — do not edit by hand.
# Regenerated on every `terraform apply`. Source: provision/terraform-yc/.
pool_id: ${pool_id}
provider: yandex

defaults:
  ssh_user: decentr
  ssh_port: 22
  ssh_key_path: ${ssh_key_path}
  port: 50051
  bind_host: 0.0.0.0
  platform: linux
  project_dir: /opt/decentr/DistLearn/Decentr_my_own
  python_env: /opt/decentr/venv
  results_dir: /opt/decentr/decentr-results
  weight: 1.0
  cpu_cores: ${cpu_cores}
  relative_speed: 1.0

# host     = private subnet IP (inter-node gRPC)
# ssh_host = IP the orchestrator SSHes to (public NAT IP for node-01,
#            private IP for nodes 02-N — reached via ProxyJump through node-01)
# ssh_jump = bastion public IP (empty for node-01 itself)
nodes:
%{ for node in nodes ~}
  - id: ${node.id}
    host: ${node.private_ip}
    ssh_host: ${node.ssh_host}
%{ if node.ssh_jump != "" ~}
    ssh_jump: ${node.ssh_jump}
%{ endif ~}
%{ endfor ~}
