# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# --- Selectel auth ----------------------------------------------------------
domain_name = "123456"                  # your Selectel account ID
username    = "decentr-svc"              # service user name
password    = "CHANGE_ME"               # service user password
project_id  = "abcdef0123456789..."     # project UUID

region            = "ru-9"
availability_zone = "ru-9a"
volume_type       = "fast.ru-9a"

# --- Sizing -----------------------------------------------------------------
server_count   = 20
flavor_id      = "1015"                  # CHANGE: run `python3 ../selectel.py list-flavors`
image_name     = "Ubuntu 24.04 LTS 64-bit"
volume_size_gb = 40

# --- SSH --------------------------------------------------------------------
ssh_public_key_path  = "~/.ssh/decentr_id_ed25519.pub"
ssh_private_key_path = "~/.ssh/decentr_id_ed25519"

# Tighten this to your home IP for security, e.g. "203.0.113.7/32"
ssh_allowed_cidr = "0.0.0.0/0"

# --- cloud-init -------------------------------------------------------------
# Render first:
#   python3 ../../render_cloud_init.py \
#     --template cloud-init.subnet.yaml.template \
#     --out cloud-init.rendered.yaml
cloud_init_path = "cloud-init.rendered.yaml"
