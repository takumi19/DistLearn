# pool.yaml.example — copy to pool.yaml and fill in real IPs.
# pool.yaml is gitignored; pool.yaml.example is tracked.
#
# In Terraform/subnet mode pool.yaml is generated automatically by
#   terraform apply  (via templates/pool.yaml.tftpl).
# You only need to hand-edit this for manual provisioning.

pool_id: selectel-ru9-20240601
provider: selectel

defaults:
  ssh_user: decentr
  ssh_port: 22
  ssh_key_path: ~/.ssh/decentr_id_ed25519
  port: 50051          # gRPC port on each node
  bind_host: 0.0.0.0
  platform: linux
  project_dir: /opt/decentr/DistLearn/Decentr_my_own
  python_env: /opt/decentr/venv
  results_dir: /opt/decentr/decentr-results
  weight: 1.0
  cpu_cores: 4
  relative_speed: 1.0

# host     = private subnet IP — used by nodes to talk to each other (gRPC)
# ssh_host = floating / public IP — used by the orchestrator to SSH in
nodes:
  - id: decentr-01
    host: 10.0.0.11
    ssh_host: 185.10.20.101

  - id: decentr-02
    host: 10.0.0.12
    ssh_host: 185.10.20.102

  - id: decentr-03
    host: 10.0.0.13
    ssh_host: 185.10.20.103

  - id: decentr-04
    host: 10.0.0.14
    ssh_host: 185.10.20.104

